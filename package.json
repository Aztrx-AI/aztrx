{
  "name": "aztrx-cli",
  "version": "0.4.5",
  "private": false,
  "description": "Aztrx AI — runtime stress-tester for web apps. Detect bugs, then prove them with an executable repro.",
  "license": "Apache-2.0",
  "author": "Danis Chaparov <d.chaparov@gmail.com>",
  "type": "module",
  "bin": {
    "aztrx-cli": "dist/cli.js"
  },
  "main": "dist/core/orchestrator.js",
  "exports": {
    ".": "./dist/core/orchestrator.js",
    "./vite": "./dist/vite/index.js",
    "./next": "./dist/next/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "media"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "testing",
    "playwright",
    "stress-test",
    "fuzzing",
    "web-app",
    "debugging",
    "repro",
    "qa",
    "e2e"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Aztrx-AI/aztrx.git"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node dist/cli.js",
    "bench": "npm run build && tsx bench/run.ts",
    "pretest": "npm run build",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json",
    "server": "tsx server/index.ts",
    "server:typecheck": "tsc -p server/tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.25",
    "commander": "^12.1.0",
    "gifenc": "^1.0.3",
    "ink": "^5.2.0",
    "picocolors": "^1.1.1",
    "playwright": "1.62.1",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.0",
    "vite": "^8.3.0"
  },
  "peerDependencies": {
    "vite": ">=4"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
